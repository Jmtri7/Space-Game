        "npcs": [
          {
            "name": "Sela Cordova",
            "x": 850,
            "y": 700,
            "role": "concierge",
            "outfit": "vherathi_steward",
            "escort_flag": "station_guide_escorting",
            "ambient": {
              "range": 700,
              "message": "New face on the ring? This is the concierge desk, middle of the concourse - straight ahead as you come off the dock. Move with WASD or the arrow keys, walk over and press T, and I'll get you flight-ready."
            },
            "dialogue_tree": {
              "root": "start",
              "conditional_roots": [
                {"flag": "station_tour_done", "node": "done"},
                {"flag": "station_tour_accepted", "node": "in_progress"}
              ],
              "nodes": {
                "start": {
                  "text": "Welcome to Alpha Station - you've found the concierge desk. First time out here, I'd guess. Want the quick tour? I'll walk you through the controls, help you line up a loan, and get you into a ship of your own.",
                  "options": [
                    {"label": "Yes, show me around.", "next": "accepted", "actions": ["set_flag:station_tour_accepted", "start_mission:station_tour"]},
                    {"label": "Maybe later.", "next": null}
                  ]
                },
                "accepted": {
                  "text": "Good call. Close the comm and lead the way - I'll be right behind you, and every step shows up in your Mission Log as we go.",
                  "options": [
                    {"label": "Lead on.", "next": null}
                  ]
                },
                "in_progress": {
                  "text": "Still with me? Check your Mission Log (N) for the current step. Or if you'd rather strike out on your own, just say the word.",
                  "options": [
                    {"label": "I'll keep following.", "next": null},
                    {"label": "I'll manage on my own.", "next": "declined", "action": "abandon_mission:station_tour"}
                  ]
                },
                "declined": {
                  "text": "Fair enough. The pods are all off the concourse - Credit Union west, Ship Dock east. Good luck out there.",
                  "options": [
                    {"label": "Thanks.", "next": null}
                  ]
                },
                "done": {
                  "text": "Back again? Ship's treating you right, I hope. Safe flying.",
                  "options": [
                    {"label": "Just passing through.", "next": null}
                  ]
                }
              }
            }
          },
          {
            "name": "Bram Solise",
            "x": 800,
            "y": 200,
            "role": "bartender",
            "outfit": "vherathi_steward",
            "dialogue_tree": {
              "root": "start",
              "conditional_roots": [
                {"flag": "bought_bartender_round", "node": "start_friendly"}
              ],
              "nodes": {
                "start": {
                  "text": "What'll it be?",
                  "options": [
                    {"label": "Order a drink", "next": "drink"},
                    {"label": "Buy him a round - 20cr", "next": "round_bought", "requires_not_flag": "bought_bartender_round", "actions": ["spend_credits:20", "give_item:engraved_flask", "set_flag:bought_bartender_round"]},
                    {"label": "Ask about the station", "next": "about_station"},
                    {"label": "Leave", "next": null}
                  ]
                },
                "start_friendly": {
                  "text": "Back again? Always good to see a paying customer who tips.",
                  "options": [
                    {"label": "Order a drink", "next": "drink"},
                    {"label": "Ask about the station", "next": "about_station"},
                    {"label": "Leave", "next": null}
                  ]
                },
                "drink": {
                  "text": "One synth-ale, on the house for a new face. Cheers.",
                  "options": [
                    {"label": "Thanks", "next": "start"},
                    {"label": "Leave", "next": null}
                  ]
                },
                "round_bought": {
                  "text": "Cheers - much obliged. Here, engraved flask, on the house. Come back anytime.",
                  "options": [
                    {"label": "Thanks", "next": null}
                  ]
                },
                "about_station": {
                  "text": "One big ring, all of it off this concourse. Credit union's the west pod, ship dock's the east one - go see Petra if you're short, then Dax about a hull.",
                  "options": [
                    {"label": "Ask about the quiet cargo runs", "next": "smuggler_tip", "requires_flag": "bought_bartender_round"},
                    {"label": "Good to know", "next": "start"},
                    {"label": "Leave", "next": null}
                  ]
                },
                "smuggler_tip": {
                  "text": "Word is Priya doesn't ask too many questions if the crate isn't labeled. Didn't hear that from me.",
                  "options": [
                    {"label": "Noted", "next": null}
                  ]
                }
              }
            }
          },
          {
            "name": "Petra Voss",
            "x": 280,
            "y": 600,
            "role": "loan_officer",
            "outfit": "vherathi_vault_warden",
            "dialogue_tree": {
              "root": "start",
              "nodes": {
                "start": {
                  "text": "First loan's on the station - more than enough to get you off the ground.",
                  "options": [
                    {"label": "Take loan - 100000cr", "next": "loaned", "action": "take_loan"},
                    {"label": "Leave", "next": null}
                  ]
                },
                "loaned": {
                  "text": "Approved. Don't make me regret it.",
                  "options": [
                    {"label": "Thanks", "next": null}
                  ]
                }
              }
            }
          },
          {
