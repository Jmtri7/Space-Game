        "npcs": [
          {
            "name": "The Grey Courier",
            "x": 250, "y": 320,
            "role": "resident",
            "outfit": "ck_smuggler_masc",
            "requires_not_flag": "met_courier",
            "ambient": {
              "range": 900,
              "message": "Someone in a grey flight coat is standing too still by the west arc, watching you. Walk over (WASD / arrows) and press T."
            },
            "dialogue_tree": {
              "root": "start",
              "nodes": {
                "start": {
                  "text": "You're the courier off the dark berth. Don't - don't say the name back to me. I was asked to put this in your hand and nothing else. It's from Elian Marr.",
                  "options": [
                    { "label": "Elian's been gone for years.", "next": "gone" },
                    { "label": "Asked by who?", "next": "who" },
                    { "label": "Give it here.", "next": "handover" }
                  ]
                },
                "gone": {
                  "text": "Gone isn't dead. Elian's a long way out and can't come in - you'll understand why when you read it. The note's a trail. Each line gets you to the next one.",
                  "options": [
                    { "label": "Asked by who?", "next": "who" },
                    { "label": "Give it here.", "next": "handover" }
                  ]
                },
                "who": {
                  "text": "Someone who owed Elian more than they could pay, same as me. That's the whole chain - favours, hand to hand, all the way out to you. I've done my part.",
                  "options": [
                    { "label": "Give it here.", "next": "handover" }
                  ]
                },
                "handover": {
                  "text": "There. It's Elian's hand, you'll know it. Read the first line before you do anything else, and for both our sakes don't file a flight plan. I was never on this ring.",
                  "options": [
                    {
                      "label": "Take the note.",
                      "next": "leaving",
                      "actions": [
                        "give_item:the_note",
                        "set_flag:met_courier",
                        "start_mission:follow_the_note"
                      ]
                    }
                  ]
                },
                "leaving": {
                  "text": "That's a hull on approach and I can't be here when it clamps on. Fly well. Elian said you were the one who wouldn't leave it alone.",
                  "options": [
                    { "label": "Wait -", "next": null }
                  ]
                }
              }
            }
          },
          {
            "name": "Deck Officer Aru",
            "x": 470, "y": 150,
            "role": "stationmaster",
            "outfit": "ck_command_femme",
            "dialogue_tree": {
              "root": "start",
              "conditional_roots": [
                { "flag": "met_courier", "node": "after" }
              ],
              "nodes": {
                "start": {
                  "text": "Kestrel Ring. Half the berths are dark and the other half wish they were. If you're not loading and not fuelling, you're just sightseeing - which is allowed, barely.",
                  "options": [
                    { "label": "Quiet posting.", "next": "quiet" },
                    { "label": "Leave", "next": null }
                  ]
                },
                "quiet": {
                  "text": "Suits me. The last time this ring got interesting, a survey pilot undocked without a plan and never pinged again. We don't miss interesting.",
                  "options": [
                    { "label": "Leave", "next": null }
                  ]
                },
                "after": {
                  "text": "That one in the grey coat cleared the dock the second a hull came in - didn't sign out, wasn't on the manifest coming in either. You know them?",
                  "options": [
                    { "label": "Never seen them before.", "next": "shrug" },
                    { "label": "Leave", "next": null }
                  ]
                },
                "shrug": {
                  "text": "Nobody has. Ring's like that lately. Keep your approach clean on the way out and we'll never speak again.",
                  "options": [
                    { "label": "Leave", "next": null }
                  ]
                }
              }
            }
          },
          {
            "name": "Fuel Hand Bosch",
            "x": 400, "y": 560,
            "role": "resident",
            "outfit": "ck_dockworker_masc",
            "greeting": "Topped your courier off when you came in. She's light and she's honest - she'll take you a long way if you don't ask her to hurry.",
            "dialogue_options": ["Leave"]
          }
        ]
      }
    }
  }
