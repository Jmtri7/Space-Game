          {
            "name": "Watch Officer Kesh",
            "x": 800,
            "y": 700,
            "role": "magistrate",
            "faction": "harbor_authority",
            "outfit": "authority_official_masc",
            "greeting": "Halcyon Watch. We track every hull in the system from here. Keep your approach clean and we'll never speak again.",
            "dialogue_options": [
              "Understood",
              "Leave"
