          },
          {
            "name": "Rell, carrier pilot",
            "x": 900,
            "y": 720,
            "role": "traveler",
            "faction": "free_carrier",
            "outfit": "ck_smuggler_masc",
            "greeting": "Twenty years I ran the slow lanes to Verdance. Now a beacon does it in an afternoon. Don't know whether to celebrate.",
