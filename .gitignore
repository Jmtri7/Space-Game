__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
.DS_Store

# Player save files - local progress, never committed
saves/

# Cached procedurally-rendered music tracks (regenerated on demand)
music_cache/

# Runtime logs from launching the game for manual verification
game_stdout.log
game_stderr.log

# Crash dump written by main.py's top-level exception handler
error.txt

# Per-machine player preferences (video resolution) - see game/utils.load_settings
settings.json
